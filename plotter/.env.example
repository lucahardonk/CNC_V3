# URL di Moonraker (stesso host di Mainsail). Se il DNS .home non funziona nel container usa l'IP.
MOONRAKER_URL=http://flsun.home
# MOONRAKER_URL=http://192.168.1.132
# Solo se Moonraker richiede autenticazione (trusted_clients non configurati)
MOONRAKER_API_KEY=
# Porta esposta sull'host
PORT=3000
